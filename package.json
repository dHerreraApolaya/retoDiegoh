{
  "name": "retoDiegoh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-doc-links.mjs",
    "start": "react-native start",
    "test": "jest",
    "preinstall": "node scripts/check-toolchain.mjs",
    "prepare": "node scripts/prepare-hooks.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "check:secrets": "secretlint \"**/*\" \".*\"",
    "check": "pnpm check:toolchain && pnpm check:docs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:tooling && pnpm test:ci && pnpm check:sensitive-files && pnpm check:secrets && pnpm check:secrets:history",
    "check:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "check:secrets:history": "node scripts/check-secret-history.mjs",
    "check:secrets:staged": "node scripts/check-staged-secrets.mjs",
    "audit:dependencies": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.5",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "secretlint": "13.0.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.34.8"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "overrides": {
      "@react-native/eslint-config>eslint-plugin-ft-flow": "3.0.11",
      "@firebase/firestore>@grpc/grpc-js": "1.14.6"
    }
  }
}
